{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "DATABASE_URL=${DATABASE_URL:-postgresql://127.0.0.1:5432/labops_test} NODE_ENV=test OIDC_ISSUER_URL=https://issuer.example OIDC_CLIENT_ID=labops-test OIDC_CLIENT_SECRET=test-only-placeholder PUBLIC_BASE_URL=http://localhost:5000 tsx --test --test-concurrency=1 src/*.test.ts src/lib/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "DATABASE_URL=${DATABASE_URL:-postgresql://127.0.0.1:5432/labops_test} npx drizzle-kit push --config=lib/db/drizzle.config.ts",
    "db:migrate": "tsx lib/db/src/migrate.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "openid-client": "^6.8.5",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "drizzle-kit": "^0.31.10"
  }
}