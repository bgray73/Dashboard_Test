# Required PostgreSQL connection. Store the real value in Replit Secrets or your deployment secret manager.
DATABASE_URL=postgresql://labops:***@127.0.0.1:5432/labops

# Required OIDC relying-party configuration. Register this exact callback:
# http://localhost:5173/api/auth/callback for Vite development (use the deployed HTTPS origin in production).
OIDC_ISSUER_URL=https://identity.example
OIDC_CLIENT_ID=labops
OIDC_CLIENT_SECRET=replace-in-secret-manager
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
PUBLIC_BASE_URL=http://localhost:5173

# Optional one-time, explicit first-user bootstrap. Set both or neither. Values must
# exactly match the approved provider issuer and stable subject; remove after first login.
# AUTH_BOOTSTRAP_ISSUER=https://identity.example
# AUTH_BOOTSTRAP_SUBJECT=approved-stable-subject

# Server-side session and one-time login-flow lifetimes.
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=43200
AUTH_FLOW_TTL_SECONDS=600
OIDC_HTTP_TIMEOUT_MS=5000

# Safe defaults: API listens only on this machine at port 5000.
PORT=5000
HOST=127.0.0.1

# Comma-separated exact browser origins. Leave empty when the frontend uses the same origin/Vite proxy.
# Example for explicit LAN deployment: CORS_ALLOWED_ORIGINS=https://labops.example
CORS_ALLOWED_ORIGINS=

# Comma-separated trusted reverse-proxy addresses/subnets. `true` is intentionally rejected.
# Leave empty unless a known reverse proxy terminates TLS in front of LabOps.
TRUST_PROXY=

# Express body limits. Collector JSON remains independently capped at 16kb.
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb

# Reachability provider: local-icmp or collector.
LABOPS_REACHABILITY_PROVIDER=local-icmp
# Required only when LABOPS_REACHABILITY_PROVIDER=collector.
# LABOPS_COLLECTOR_ID=1

# Frontend development settings.
API_PROXY_TARGET=http://localhost:5000
BASE_PATH=/
